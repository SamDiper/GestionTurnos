{
  "RateLimiting": {
    "EnableRateLimiting": true,
    "PermitLimit": 100,
    "WindowSeconds": 60,
    "QueueLimit": 0
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.MSSqlServer",
      "Serilog.Sinks.Async",
      "Serilog.Enrichers.Environment",
      "Serilog.Enrichers.Thread"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ],
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "MSSqlServer",
              "Args": {
                "connectionString": "DefaultConnection",
                "tableName": "Log",
                "schemaName": "Logging",
                "autoCreateSqlTable": false
              }
            }
          ]
        }
      }
    ]
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200"
    ]
  },
  "Jwt": {
    "Key": "SuperSecretKeyParaTokensJwtMUYSEGURA2026!GestionTurnos2026",
    "Issuer": "GestionTurnosApi",
    "Audience": "AngularApp",
    "AccessTokenExpirationMinutes": 60,
    "RefreshTokenExpirationDays": 7
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=GestionTurnos;Trusted_Connection=True;TrustServerCertificate=True;Pooling=true;"
  },
  "Database": {
    "ConnectionStringName": "DefaultConnection",
    "CommandTimeoutSeconds": 30,
    "EnableRetryOnFailure": false,
    "MaxRetryCount": 3,
    "MaxRetryDelaySeconds": 10,
    "EnableSensitiveDataLogging": false,
    "EnableDetailedErrors": false
  },
  "DataProtection": {
    "ApplicationName": "GestionTurnos",
    "PersistToDatabase": true
  },
  "AppSettings": {
    "TimeZone": "America/Bogota",
    "PermitirAsistenciaSinTurno": false
  }
}
